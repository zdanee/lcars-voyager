// ╭──────────────────────────────────────────────────────────────────────────╮
// │                                                                          │
// │   C O N F I G                                                            │
// │   terminal greeting · TNG commbadge + system readout                     │
// │                                                                          │
// │   github.com/andreumassanet/impasto                                      │
// │                                                                          │
// ╰──────────────────────────────────────────────────────────────────────────╯

{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  // The Next Generation commbadge — the delta over its plate — traced from
  // the source artwork into half-blocks, so the same insignia prints in any
  // terminal. `$1` is the delta (colour 1, #ff9c00, the palette's accent
  // orange), `$2` the plate behind it (colour 2, #6699ff, the LCARS blue).
  "logo": {
    "type": "data",
    "source": "$1            $1▄█\n$1           ▄██▄\n$1          ▄████▄\n$1         ▄██████\n$1         ████████\n$1     $2▄▄█$1██████████$2▄▄\n$1   $2▄███▀$1██████████$2████▄\n$1  $2█████$1████████████$2█████\n$1 $2█████$1█████████████$2▀█████\n$1 $2█████$1█████▀$2████$1▀███$2█████\n$1  $2███$1████▀$2███████$1▀██$2▀███\n$1   $2▀█$1███$2██████████$1▀██$2█▀\n$1     █▀$2▀██████████▀$1▀█\n$1    █▀              ▀█\n$1    ▀                ▀",
    "color": {
      "1": "#ff9c00",
      "2": "#6699ff"
    },
    "padding": {
      "top": 0,
      "right": 3,
      "left": 1
    }
  },

  "display": {
    "separator": "  ",
    // Cyan carries the accent in the generated kitty palette.
    "color": {
      "keys": "cyan"
    }
  },

  // The readout beside the badge: system first, then what it runs on. Keys
  // are one glyph, label and padding wide enough to line every value up; the
  // board in the island keeps its own live copy of the same lines.
  "modules": [
    {
      "type": "title",
      "format": "  {#36}󰣇 {#default}{user-name}{#37}@{#default}{host-name}"
    },
    {
      "type": "os",
      "key": "  󰣇 os     ",
      "format": "{pretty-name}"
    },
    {
      "type": "kernel",
      "key": "  󰒓 kernel ",
      "format": "{release}"
    },
    {
      "type": "wm",
      "key": "  󰖳 wm     "
    },
    {
      "type": "terminal",
      "key": "  󰆍 term   "
    },
    {
      "type": "separator",
      "string": "  ──────────────────────────",
      "outputColor": "#6699ff"
    },
    {
      "type": "cpu",
      "key": "  󰘚 cpu    "
    },
    {
      "type": "memory",
      "key": "  󰍛 ram    "
    },
    {
      "type": "gpu",
      "key": "   gpu    "
    },
    {
      "type": "display",
      "key": "  󰍹 display",
      "compactType": "original-with-refresh-rate"
    },
    {
      "type": "uptime",
      "key": "  󰅐 uptime "
    },
    // The badge is taller than these lines; one blank line keeps the prompt
    // from landing on it.
    "break"
  ]
}
